# Copy this file to `.env` in the backend/ folder and fill in your
# own local MySQL credentials. `.env` is gitignored — never commit it.
#
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>

DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD_HERE@localhost:3306/missubibi
# Optional deployment protection for /api routes.
# PLANNING_API_KEY=replace-with-a-long-random-value
